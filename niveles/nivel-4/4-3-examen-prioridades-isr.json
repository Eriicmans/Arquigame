    "questions": [
      {
        "id": "q-multicycle",
        "prompt": "Si EX0 se activa justo en el segundo ciclo máquina de una instrucción MUL AB (que dura 4 ciclos), ¿cuándo salta el 80C552 al vector 0003h?",
        "options": [
          "Inmediatamente en el ciclo 2, abortando MUL AB",
          "Al finalizar los 4 ciclos completos de MUL AB",
          "Solo cuando el programa principal ejecute un RETI",
          "Después de completar también la siguiente instrucción"
        ],
        "correctIndex": 1,
        "explanation": "Regla de oro: la CPU siempre termina la instrucción multiciclo en curso antes de apilar el PC y saltar a la ISR."
      }
    ]
