  "flowchartTask": {
    "title": "ISR de Emergencia EX0 (interrumpe a la ISR del ADC)",
    "blocks": [
      {
        "id": "e-vec",
        "label": "Vector 0003h: LJMP ISR_EMERG",
        "code": "ORG 0003h ; LJMP ISR_EMERG",
        "kind": "start"
      },
      {
        "id": "e-push",
        "label": "Salvar contexto (PSW y ACC)",
        "code": "PUSH PSW ; PUSH ACC",
        "kind": "stack"
      },
      {
        "id": "e-act",
        "label": "Cortar actuadores y marcar FLAG_EMERG",
        "code": "MOV PWM0, #00h ; SETB FLAG_EMERG",
        "kind": "action"
      },
      {
        "id": "e-pop",
        "label": "Restaurar contexto en orden LIFO",
        "code": "POP ACC ; POP PSW",
        "kind": "stack"
      },
      {
        "id": "e-reti",
        "label": "Retornar restaurando prioridad del ADC",
        "code": "RETI",
        "kind": "return"
      },
      {
        "id": "e-bug-clr-ea",
        "label": "Dejar EA = 0 al salir de la ISR",
        "code": "CLR EA ; RET",
        "kind": "bug"
      },
      {
        "id": "e-bug-wait",
        "label": "Bucle infinito dentro de la ISR",
        "code": "WAIT: SJMP WAIT",
        "kind": "bug"
      }
    ],
    "expectedOrder": ["e-vec", "e-push", "e-act", "e-pop", "e-reti"],
    "distractorIds": ["e-bug-clr-ea", "e-bug-wait"]
  }
